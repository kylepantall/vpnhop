{
  "name": "vpnhop",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that sends API calls through a VPN tunnel running in a throwaway Docker container, so you never connect your machine to the VPN.",
  "type": "module",
  "bin": {
    "vpnhop": "src/index.ts"
  },
  "scripts": {
    "start": "node src/index.ts serve",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.ts",
    "test:smoke": "node scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "Kyle Pantall",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
